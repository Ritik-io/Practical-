#include <iostream>
#include <sstream>
#include <string>
#include <cctype>
#include <stdexcept>
using namespace std;

// Abstract base class
class WordDemo {
private:
    string str;                         // private data member

protected:
    string getStr() const {             // lets derived class read the private string
        return str;
    }

public:
    WordDemo(string s) {                // parameterized constructor
        str = s;
    }

    virtual void countVowelWords() = 0; // pure virtual function

    virtual ~WordDemo() {}
};

// Derived class
class StringDemo : public WordDemo {
public:
    StringDemo(string s) : WordDemo(s) {}   // pass string to base constructor

    void countVowelWords() override {
        stringstream ss(getStr());
        string word;
        int count = 0;

        while (ss >> word) {
            char ch = tolower(word[0]);
            if (ch == 'a' || ch == 'e' || ch == 'i' || ch == 'o' || ch == 'u') {
                count++;
            }
        }

        if (count > 4) {
            throw runtime_error("More than 4 words start with a vowel!");
        }

        cout << "Frequency of words starting with a vowel: " << count << endl;
    }
};

int main() {
    string s;
    cout << "Enter a sentence: ";
    getline(cin, s);

    WordDemo *ptr = new StringDemo(s);   // base pointer -> derived object

    try {
        ptr->countVowelWords();          // runtime polymorphism
    }
    catch (runtime_error &e) {
        cout << "Error: " << e.what() << endl;
    }

    delete ptr;
    return 0;
}


