#include <iostream>
#include <fstream>
#include <stdexcept>
using namespace std;

int main()
{
    int a[4], b[4], c[8];

    ifstream fin("data.txt");

    if (!fin)
    {
        cout << "File cannot be opened";
        return 1;
    }

    int temp, i = 0;

    // Read numbers using one while loop
    while (fin >> temp)
    {
        if (i < 4)
            a[i] = temp;
        else if (i < 8)
            b[i - 4] = temp;

        i++;
    }

    fin.close();

    if (i < 8)
    {
        cout << "Insufficient data";
        return 1;
    }

    // Merge arrays
    int k = 0;
    i = 0;

    while (i < 4)
    {
        c[k++] = a[i];
        c[k++] = b[3 - i];
        i++;
    }

    try
    {
        int count = 0;
        i = 0;

        while (i < 8)
        {
            if (c[i] % 2 == 0)
                count++;

            i++;
        }

        if (count > 5)
            throw runtime_error("Even count is greater than 5!");

        cout << "C array: ";

        i = 0;
        while (i < 8)
        {
            cout << c[i] << " ";
            i++;
        }
    }
    catch (runtime_error &e)
    {
        cout << "Error: " << e.what();
    }

    return 0;
}

